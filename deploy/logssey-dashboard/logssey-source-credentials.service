[Unit]
Description=Publish short-lived Logssey application AWS role sessions
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/logssey/publish-aws-credentials.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/logssey/aws
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
