[Unit]
Description=Synchronize the Logssey runtime collector secret
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/logssey/sync-runtime-collector-secret.py
TimeoutStartSec=180
StateDirectory=logssey-runtime
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/logssey/secrets/api /var/lib/logssey-runtime
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
