[Unit]
Description=Collect the Logssey IaC security asset graph (Cartography) and record the run
Wants=network-online.target
After=network-online.target docker.service logssey-iac-credentials.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/logssey
ExecStart=/opt/logssey/run-iac-collector.sh
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
